# DermaLens AI app configuration.
#   cp frontend/.env.example frontend/.env
#
# EXPO_PUBLIC_* variables are INLINED INTO THE BUNDLE at build/export time.
# Changing this value requires a rebuild — it is not read at runtime, and it
# must never hold a secret (anyone can read it out of the shipped app).

# Public origin of your self-hosted backend, no trailing slash.
#   local development against the compose stack : http://localhost:8000
#   Android emulator talking to your laptop     : http://10.0.2.2:8000
#   production                                  : https://api.aivicventures.com
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000
