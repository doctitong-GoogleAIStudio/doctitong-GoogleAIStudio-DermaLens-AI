# DermaLens AI backend configuration.
# Copy to backend/.env and fill in. Never commit the real file.
#
#   cp backend/.env.example backend/.env
#
# Generate the secrets with:
#   openssl rand -hex 32

# =============================================================================
# Required
# =============================================================================

# MongoDB connection string.
#   docker compose  -> leave as-is, compose overrides it with the mongo service
#   local mongod    -> mongodb://localhost:27017
#   MongoDB Atlas   -> mongodb+srv://user:pass@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017

# Database name inside that server.
DB_NAME=dermalens

# Signs the JWTs handed to the app. Changing it logs every user out.
# openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# Google Gemini API key. Get one at https://aistudio.google.com/apikey
# This key stays on the server — it is never shipped in the mobile bundle.
GEMINI_API_KEY=

# =============================================================================
# Optional — app behaviour
# =============================================================================

# Vision model used for analysis.
GEMINI_MODEL=gemini-3.1-pro-preview

# JWT lifetime in minutes (default 43200 = 30 days).
JWT_EXPIRE_MINUTES=43200

# Per-account analyses allowed per hour (burst / abuse ceiling).
ANALYSES_PER_HOUR=10

# Per-account analyses allowed per calendar month (UTC). This is the ceiling
# that bounds what one account can cost you: the hourly limit alone still
# permits ~7,200 analyses a month, which costs far more in Gemini usage than
# any subscription brings in.
#
# The default is low on purpose. While ENFORCE_FREE_TIER is false this cap
# applies to every account equally, subscribed or not, and signups are
# unlimited — so your exposure is this number times however many accounts
# someone chooses to create, not times your subscriber count.
#
# Sizing it, using numbers from scripts/measure-gemini-cost.py:
#   ~$0.013 per analysis on gemini-3.1-pro-preview
#    30 analyses = ~$0.39 per account, and still a scan a day
#   100 analyses = ~$1.30, about 30% of what a $4.99 plan nets after Play's cut
# 30 is also the allowance of the $4.99/month plan: $0.39 of cost against $4.24
# net of Google Play's cut, a 91% margin at the cap and 99% at realistic use.
#
# IMPORTANT: until ENFORCE_FREE_TIER is true this same 30 is what an unpaid
# account gets, so the subscription grants nothing a free signup does not
# already have. Enforcing the free tier is what turns this number into a paid
# benefit. Re-measure when you change GEMINI_MODEL. Set to 0 to disable.
ANALYSES_PER_MONTH=30

# Free analyses per account before the paywall.
# Must match FREE_ANALYSES in frontend/src/billing/products.ts.
FREE_ANALYSES=1

# Enforce FREE_ANALYSES on the server for accounts with no active subscription.
# Leave false until Play verification is working and the app reliably reports
# purchase tokens: the server only learns about a subscription when the app
# calls /api/billing/subscription, so enabling this too early locks out paying
# users. While it is false the backend logs "free-tier: would block ..." for
# each request that WOULD be refused, so you can measure the effect first.
# Requires PLAY_SERVICE_ACCOUNT_JSON; without it the setting does nothing.
ENFORCE_FREE_TIER=false

# Public https origin of THIS backend.
# Printed inside the privacy policy and the account-deletion page, and used as
# the Play Console privacy-policy / account-deletion URL.
PUBLIC_BASE_URL=https://api.aivicventures.com

# Shown as the contact address on the public pages.
SUPPORT_EMAIL=support@aivicventures.com

# Uvicorn worker processes (docker compose only).
WEB_CONCURRENCY=2

# Web origins allowed to call this API from a BROWSER, comma-separated.
# The mobile app sends no Origin header and ignores this entirely.
# "*" allows any origin; narrow it once the web build is live:
#   CORS_ALLOW_ORIGINS=https://app.aivicventures.com,https://aivicventures.com
CORS_ALLOW_ORIGINS=*

# =============================================================================
# Optional — email (admin notifications only)
# =============================================================================
# Used for device-activation requests and account-deletion notices. Leave the
# whole section empty to disable email: those endpoints still succeed and simply
# report "emailed": false, and the records stay readable in the database.

# Where the notifications go. Comma-separated for more than one address.
ADMIN_EMAIL=admin@aivicventures.com

# "smtp" or "resend". Leave blank to auto-detect from the credentials below.
EMAIL_PROVIDER=

# Envelope sender. Must be an address you are allowed to send as.
EMAIL_FROM=noreply@aivicventures.com
EMAIL_FROM_NAME=DermaLens AI

# --- SMTP (any provider, or your own mail server) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# starttls (port 587, default) | ssl (port 465) | none (unencrypted; LAN only)
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=30

# --- Resend HTTPS API (alternative to SMTP) ---
RESEND_API_KEY=

# =============================================================================
# Optional — Google Play (subscriptions)
# =============================================================================

# Play package name. Must match android.package in frontend/app.json. Play binds
# it permanently on the first upload, so change it only before publishing.
ANDROID_PACKAGE_NAME=com.aivicventures.dermalensai.app

# Service-account JSON (inline, or an absolute path to the file) with the Play
# Console "View financial data / Manage orders and subscriptions" permission.
# Leave empty to skip server-side purchase verification.
PLAY_SERVICE_ACCOUNT_JSON=

# Comma-separated Play offer ids that are free trials, e.g. freetrial-7d
PLAY_TRIAL_OFFER_IDS=

# =============================================================================
# Optional — device activation
# =============================================================================

# HMAC secret behind the offline activation keys. No default: with it unset the
# activation endpoints return 503, which is correct if you do not use the
# device-activation flow at all.
#
# The value that used to be hardcoded here is published in this repository's git
# history, so it must never be reused — anyone could mint valid keys with it.
# Generate a fresh one:  openssl rand -hex 32
#
# It must match in three places: this variable, the secret compiled into the
# app, and AiDerma-Activation-Generator.html (or just use the ready-filled copy
# the backend serves at /api/activation-tool). Changing it later invalidates
# every key already issued.
ACTIVATION_SECRET=

# Days a sha256(email) deletion record is kept (legal / billing disputes).
DELETION_RECORD_RETENTION_DAYS=730
