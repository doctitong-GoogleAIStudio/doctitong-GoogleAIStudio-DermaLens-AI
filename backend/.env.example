# DermaLens AI backend configuration.
# Copy to backend/.env and fill in. Never commit the real file.
#
#   cp backend/.env.example backend/.env
#
# Generate the secrets with:
#   openssl rand -hex 32

# =============================================================================
# Required
# =============================================================================

# MongoDB connection string.
#   docker compose  -> leave as-is, compose overrides it with the mongo service
#   local mongod    -> mongodb://localhost:27017
#   MongoDB Atlas   -> mongodb+srv://user:pass@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017

# Database name inside that server.
DB_NAME=dermalens

# Signs the JWTs handed to the app. Changing it logs every user out.
# openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# Google Gemini API key. Get one at https://aistudio.google.com/apikey
# This key stays on the server — it is never shipped in the mobile bundle.
GEMINI_API_KEY=

# =============================================================================
# Optional — app behaviour
# =============================================================================

# Vision model used for analysis.
GEMINI_MODEL=gemini-3.1-pro-preview

# JWT lifetime in minutes (default 43200 = 30 days).
JWT_EXPIRE_MINUTES=43200

# Per-account analyses allowed per hour (abuse / cost ceiling).
ANALYSES_PER_HOUR=10

# Free analyses per account before the paywall.
# Must match FREE_ANALYSES in frontend/src/billing/products.ts.
FREE_ANALYSES=1

# Public https origin of THIS backend.
# Printed inside the privacy policy and the account-deletion page, and used as
# the Play Console privacy-policy / account-deletion URL.
PUBLIC_BASE_URL=https://api.aivicventures.com

# Shown as the contact address on the public pages.
SUPPORT_EMAIL=support@aivicventures.com

# Uvicorn worker processes (docker compose only).
WEB_CONCURRENCY=2

# Web origins allowed to call this API from a BROWSER, comma-separated.
# The mobile app sends no Origin header and ignores this entirely.
# "*" allows any origin; narrow it once the web build is live:
#   CORS_ALLOW_ORIGINS=https://app.aivicventures.com,https://aivicventures.com
CORS_ALLOW_ORIGINS=*

# =============================================================================
# Optional — email (admin notifications only)
# =============================================================================
# Used for device-activation requests and account-deletion notices. Leave the
# whole section empty to disable email: those endpoints still succeed and simply
# report "emailed": false, and the records stay readable in the database.

# Where the notifications go. Comma-separated for more than one address.
ADMIN_EMAIL=admin@aivicventures.com

# "smtp" or "resend". Leave blank to auto-detect from the credentials below.
EMAIL_PROVIDER=

# Envelope sender. Must be an address you are allowed to send as.
EMAIL_FROM=noreply@aivicventures.com
EMAIL_FROM_NAME=DermaLens AI

# --- SMTP (any provider, or your own mail server) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# starttls (port 587, default) | ssl (port 465) | none (unencrypted; LAN only)
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=30

# --- Resend HTTPS API (alternative to SMTP) ---
RESEND_API_KEY=

# =============================================================================
# Optional — Google Play (subscriptions)
# =============================================================================

# Play package name. Do NOT change this: Google Play identifies the published
# app by it permanently, regardless of who hosts the backend.
ANDROID_PACKAGE_NAME=com.emergent.aidermatologistapp.r2pygs

# Service-account JSON (inline, or an absolute path to the file) with the Play
# Console "View financial data / Manage orders and subscriptions" permission.
# Leave empty to skip server-side purchase verification.
PLAY_SERVICE_ACCOUNT_JSON=

# Comma-separated Play offer ids that are free trials, e.g. freetrial-7d
PLAY_TRIAL_OFFER_IDS=

# =============================================================================
# Optional — device activation
# =============================================================================

# HMAC secret for the offline activation-key generator. Must match the value
# baked into the app and AiDerma-Activation-Generator.html. Changing it
# invalidates every key already issued.
ACTIVATION_SECRET=

# Days a sha256(email) deletion record is kept (legal / billing disputes).
DELETION_RECORD_RETENTION_DAYS=730
