# Configuration for `docker compose` itself (the stack, not the app).
# Copy to .env next to docker-compose.yml. The backend's own settings live in
# backend/.env — see backend/.env.example.
#
#   cp .env.example .env
#   cp backend/.env.example backend/.env

# --- Database ----------------------------------------------------------------
# Credentials for the bundled MongoDB container. Used to build the backend's
# MONGO_URL, so change them BEFORE the first `up` (they are applied when the
# data volume is initialised and ignored afterwards).
MONGO_ROOT_USER=dermalens
MONGO_ROOT_PASSWORD=CHANGE_ME_openssl_rand_hex_24

# --- Backend -----------------------------------------------------------------
# Uvicorn worker processes.
WEB_CONCURRENCY=2

# --- Web build (`--profile web`) ---------------------------------------------
# Baked into the web bundle as EXPO_PUBLIC_BACKEND_URL. Must be the public
# origin of the backend as a BROWSER sees it.
PUBLIC_BACKEND_URL=https://api.aivicventures.com

# --- TLS proxy (`--profile proxy`) -------------------------------------------
# DNS for these domains must already point at this host.
API_DOMAIN=api.aivicventures.com
# Leave unset if you are not serving the web app.
WEB_DOMAIN=app.aivicventures.com
# Address Let's Encrypt uses for expiry notices.
TLS_EMAIL=admin@aivicventures.com
