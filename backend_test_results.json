{
  "priority1_billing_usage": [
    {
      "test": "GET /api/billing/usage without auth returns 401",
      "passed": true,
      "details": {
        "status": 401,
        "body": "{\"detail\":\"Not authenticated\"}"
      }
    },
    {
      "test": "GET /api/billing/usage with token returns 200 with correct initial values",
      "passed": true,
      "details": {
        "status": 200,
        "analyses_used": 0,
        "free_analyses": 1,
        "expected": "analyses_used=0, free_analyses=1",
        "full_response": {
          "analyses_used": 0,
          "free_analyses": 1
        }
      }
    },
    {
      "test": "Counter increments after inserting analysis_logs doc",
      "passed": true,
      "details": {
        "analyses_used": 1,
        "expected": 1,
        "inserted_doc_id": "6aaac1674663b00428bf0445"
      }
    }
  ],
